# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=consumer_intelligence
DB_DIALECT=mysql

# JWT (access token only - refresh tokens are random crypto bytes, not JWTs)
JWT_SECRET=replace-this-with-a-strong-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Business rules
DORMANT_DAYS_THRESHOLD=60
HIGH_VALUE_SPEND_THRESHOLD=50000
CROSS_BRAND_MIN_BRANDS=2
